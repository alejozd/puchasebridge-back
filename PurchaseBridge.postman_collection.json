{
	"info": {
		"_postman_id": "7d9e8f42-4b2a-4c8e-9d3f-1a5b6c7d8e9f",
		"name": "PurchaseBridge",
		"description": "Colección completa para la API de PurchaseBridge (Delphi/Horse Backend). Permite gestionar el procesamiento de facturas XML, homologación de productos, métricas de dashboard y licenciamiento.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "🔐 Authentication",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const res = pm.response.json();",
									"if (res.token || res.accessToken || res.data?.token) {",
									"  pm.collectionVariables.set(\"auth_token\", res.token || res.accessToken || res.data.token);",
									"  console.log(\"✅ Token guardado en colección\");",
									"} else {",
									"  console.warn(\"⚠️ No se encontró token en la respuesta\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"usuario\": \"ADMIN\",\n    \"clave\": \"1234\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Inicia sesión con credenciales de Helisa. Si tiene éxito, el token se guarda automáticamente en la variable de colección `auth_token`."
					},
					"response": []
				}
			]
		},
